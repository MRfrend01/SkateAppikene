@model List<SkateAppikene.Models.Pin>

@{
    ViewData["Title"] = "Kaart";
}

<style>
    .map-page {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 768px) {
        .map-page {
            grid-template-columns: 1fr;
        }
    }

    .map-frame-outer {
        background: #FFE600;
        transform: rotate(-0.8deg);
        border-radius: 4px;
        padding: 6px;
    }

    .map-frame-inner {
        border: 3px solid #2563EB;
        border-radius: 2px;
        overflow: hidden;
        transform: rotate(0.8deg);
    }

    #map {
        height: 480px;
        width: 100%;
        display: block;
    }

    .pin-panel-wrap {
        position: relative;
    }

    .pin-panel-outer {
        background: #FFE600;
        transform: rotate(1.5deg);
        border-radius: 4px;
        padding: 6px;
        transition: transform 0.2s;
    }

    .pin-panel-img {
        border: 3px solid #2563EB;
        border-radius: 2px;
        overflow: hidden;
        height: 160px;
        background: #1a2744;
        transform: rotate(-1.5deg);
    }

        .pin-panel-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pin-panel-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.2);
        font-size: 13px;
    }

    .pin-panel-body {
        padding: 10px 4px 4px;
        color: #111;
    }

    .pin-panel-row {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 700;
        color: #111;
        margin-bottom: 2px;
    }

    .pin-panel-coords {
        font-size: 11px;
        color: #444;
        margin-bottom: 8px;
    }

    .pin-panel-btn {
        background: #2563EB;
        color: #fff;
        border: none;
        padding: 7px 16px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        width: 100%;
        text-align: center;
    }

        .pin-panel-btn:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .map-heading {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 1rem;
    }
</style>

<p class="map-heading">Vali park kaardilt:</p>

<div class="map-page">
    <div>
        <div class="map-frame-outer">
            <div class="map-frame-inner">
                <div id="map"></div>
            </div>
        </div>
    </div>

    <div class="pin-panel-wrap">
        <div class="pin-panel-outer" id="pinPanelOuter">
            <div class="pin-panel-img" id="pinPanelImg">
                <div class="pin-panel-img-placeholder" id="pinPanelPlaceholder">← Kliki kaardil pargile</div>
                <img id="pinPanelImgEl" src="" alt="" style="display:none;" />
            </div>
            <div class="pin-panel-body">
                <div class="pin-panel-row">
                    <span id="pinPanelNimi" style="color:#111;">—</span>
                    <span id="pinPanelTase" style="color:#111;">—</span>
                </div>
                <div class="pin-panel-coords" id="pinPanelCoords"></div>
                <a href="#" class="pin-panel-btn" id="pinPanelBtn" style="display:none;">Vaata reviews</a>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const map = L.map('map').setView([59.4370, 24.7536], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    function showPin(nimi, tase, lat, lng, imageUrl) {
        document.getElementById('pinPanelNimi').textContent = nimi;
        document.getElementById('pinPanelTase').textContent = tase || '—';
        document.getElementById('pinPanelCoords').textContent =
            lat.toFixed(4) + '°N  ' + lng.toFixed(4) + '°E';

        var btn = document.getElementById('pinPanelBtn');
        btn.href = '/Review/ParkReviews?parkName=' + encodeURIComponent(nimi);
        btn.style.display = 'block';

        var img = document.getElementById('pinPanelImgEl');
        var placeholder = document.getElementById('pinPanelPlaceholder');

        if (imageUrl) {
            img.src = imageUrl;
            img.style.display = 'block';
            placeholder.style.display = 'none';
        } else {
            img.style.display = 'none';
            placeholder.textContent = '📸 pole pilti';
            placeholder.style.display = 'flex';
        }
    }

    var hardcoded = [
        { nimi: "Tallinna Skatepark", asukoht: [59.4370, 24.7536], tase: "Kesktase" },
        { nimi: "Ülemiste Skatepark", asukoht: [59.4225, 24.7794], tase: "Algaja" },
        { nimi: "Kopli Skatepark",    asukoht: [59.4502, 24.7215], tase: "Pro" }
    ];

    hardcoded.forEach(function(p) {
        var m = L.marker(p.asukoht).addTo(map);
        m.on('click', function() {
            showPin(p.nimi, p.tase, p.asukoht[0], p.asukoht[1], null);
        });
        m.bindPopup('<b>' + p.nimi + '</b><br>Tase: ' + p.tase);
    });

    @foreach (var pin in Model)
    {
            <text>
            (function() {
                var m = L.marker([@pin.Latitude, @pin.Longitude]).addTo(map);
                m.on('click', function() {
                    showPin(
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pin.Nimi)),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pin.Tase ?? "")),
                        @pin.Latitude,
                        @pin.Longitude,
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pin.ImageUrl ?? ""))
                    );
                });
                m.bindPopup('<b>@pin.Nimi</b><br>Tase: @pin.Tase');
            })();
            </text>
    }

    @if (Context.Session.GetString("Email") == "admin@skateapp.ee")
    {
            <text>
            map.on('click', function(e) {
                var nimi = prompt("Sisesta skatepargi nimi:");
                if (!nimi) return;
                var tase = prompt("Sisesta tase: Algaja / Kesktase / Pro");
                if (!tase) return;
                fetch('/Home/AddPin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'nimi=' + encodeURIComponent(nimi) +
                          '&tase=' + encodeURIComponent(tase) +
                          '&latitude=' + e.latlng.lat +
                          '&longitude=' + e.latlng.lng
                }).then(function() { location.reload(); });
            });
            </text>
    }

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(pos) {
            map.setView([pos.coords.latitude, pos.coords.longitude], 13);
            L.circleMarker([pos.coords.latitude, pos.coords.longitude], {
                radius: 10, color: '#e87722', fillColor: '#e87722', fillOpacity: 0.8
            }).addTo(map).bindPopup("Sina oled siin").openPopup();
        });
    }
</script>