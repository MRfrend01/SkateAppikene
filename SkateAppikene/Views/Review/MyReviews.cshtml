@model List<SkateAppikene.Models.Review>

<h1>My Reviews</h1>

<div class="review-container">

    @foreach (var review in Model)
    {
        <a asp-action="Details"
           asp-route-id="@review.Id">

            <div class="review-card">

                <img src="@review.ParkImage">

                <div class="bottom">

                    <h3>@review.ParkName</h3>

                    <p>
                        ⭐ @review.Score
                    </p>

                </div>

            </div>

        </a>
    }

</div>

<style>

    .review-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .review-card {
        width: 250px;
        border: 1px solid #ccc;
        padding: 10px;
    }

        .review-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    a {
        text-decoration: none;
        color: black;
    }

</style>