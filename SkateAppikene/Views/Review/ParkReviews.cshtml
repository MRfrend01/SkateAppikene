@model List<SkateAppikene.Models.Review>

<h2>@ViewBag.ParkName Reviews</h2>

@if (!Model.Any())
{
    <p>Selle skatepargi kohta pole veel review'sid.</p>
}
else
{
    <div class="review-container">

        @foreach (var review in Model)
        {
            <div class="review-card">

                <img src="@review.ParkImage"
                     alt="@review.ParkName" />

                <div class="review-content">

                    <h4>@review.ParkName</h4>

                    <p>
                        ⭐ @review.Score / 5
                    </p>

                    <p>
                        @review.Kasutajanimi
                    </p>

                </div>

            </div>
        }

    </div>
}

<style>

    .review-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .review-card {
        width: 250px;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0,0,0,.2);
    }

        .review-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    .review-content {
        padding: 15px;
    }

</style>