@model List<SkateAppikene.Models.Review>

@{
    ViewData["Title"] = "Minu Reviews";
}

<style>
    .my-reviews-title {
        font-size: 2.5rem;
        font-weight: 900;
        color: #fff;
        margin-bottom: 1.75rem;
        letter-spacing: -1px;
    }

    .rev-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }

    .rev-card-wrap {
        width: 220px;
    }

    .rev-card-outer {
        background: #FFE600;
        transform: rotate(-2deg);
        border-radius: 4px;
        padding: 6px 6px 14px;
        transition: transform 0.15s;
        cursor: pointer;
    }

        .rev-card-outer:hover {
            transform: rotate(0deg) scale(1.04);
        }

    .rev-card-img {
        border: 3px solid #2563EB;
        border-radius: 2px;
        overflow: hidden;
        height: 130px;
        background: #1a2744;
    }

        .rev-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .rev-card-img-ph {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.2);
        font-size: 12px;
    }

    .rev-card-meta {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        font-weight: 800;
        color: #111;
        margin-top: 6px;
        padding: 0 2px;
    }

    .rev-card-btn {
        display: block;
        background: #2563EB;
        color: #fff;
        border: none;
        padding: 5px 0;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        margin-top: 6px;
        width: 100%;
    }

        .rev-card-btn:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .rev-empty {
        color: rgba(255,255,255,0.4);
        font-size: 15px;
    }

    .rev-card-wrap:nth-child(2n) .rev-card-outer {
        transform: rotate(1.5deg);
    }

    .rev-card-wrap:nth-child(3n) .rev-card-outer {
        transform: rotate(-1deg);
    }
</style>

<h1 class="my-reviews-title">Your Reviews</h1>

@if (!Model.Any())
{
    <p class="rev-empty">Sul pole veel ühtegi review'i. <a href="/Home/Map" style="color:#FFE600;">Lisa esimene!</a></p>
}
else
{
    <div class="rev-grid">
        @foreach (var rev in Model)
        {
            <div class="rev-card-wrap">
                <div class="rev-card-outer">
                    <div class="rev-card-img">
                        @if (!string.IsNullOrEmpty(rev.ParkImage))
                        {
                            <img src="@rev.ParkImage" alt="@rev.ParkName" />
                        }
                        else
                        {
                            <div class="rev-card-img-ph">📸</div>
                        }
                    </div>
                    <div class="rev-card-meta">
                        <span>@rev.ParkName</span>
                        <span>⭐@rev.Score</span>
                    </div>
                    <a asp-action="Details" asp-route-id="@rev.Id" class="rev-card-btn">
                        See your review
                    </a>
                </div>
            </div>
        }
    </div>
}