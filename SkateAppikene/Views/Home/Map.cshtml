@model List<SkateAppikene.Models.Pin>

@{
    ViewData["Title"] = "Kaart";
}

<h2 class="mb-4">Skatepargid sinu lähedal</h2>

@if (Context.Session.GetString("Email") == "admin@skateapp.ee")
{
    <p>Admin: kliki kaardile, et lisada uus skatepark 📍</p>
}

<div id="map" style="height: 500px; border-radius: 12px;"></div>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    const vaikimisiAsukoht = [59.4370, 24.7536];

    const map = L.map('map')
        .setView(vaikimisiAsukoht, 13);

    L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution: '© OpenStreetMap'
        })
        .addTo(map);

    const pargid = [

        {
            nimi: "Tallinna Skatepark",
            asukoht: [59.4370, 24.7536],
            tase: "Kesktase"
        },

        {
            nimi: "Ülemiste Skatepark",
            asukoht: [59.4225, 24.7794],
            tase: "Algaja"
        },

        {
            nimi: "Kopli Skatepark",
            asukoht: [59.4502, 24.7215],
            tase: "Pro"
        }

    ];

       pargid.forEach(park => {

        L.marker(park.asukoht)
            .addTo(map)
            .bindPopup(
                `<b>${park.nimi}</b>
                <br>
                Tase: ${park.tase}
                <br><br>
                <a href="/Review/ParkReviews?parkName=${encodeURIComponent(park.nimi)}">
                    Vaata review'sid
                </a>`
            );

    });

</script>

@foreach (var pin in Model)
{
    <script>

        var popup_@pin.Id = `
            <b>@pin.Nimi</b>
            <br>
            Tase: @pin.Tase
            <br><br>

            <a href="/Review/ParkReviews?parkName=@pin.Nimi">
                Vaata review'sid
            </a>

            @if (Context.Session.GetString("Email") == "admin@skateapp.ee")
            {
                    @:<br><br>
                    @:<button onclick="deletePin(@pin.Id)">
                    @:Kustuta
                    @:</button>
            }
        `;

        L.marker([
            @pin.Latitude,
            @pin.Longitude
        ])
        .addTo(map)
        .bindPopup(popup_@pin.Id);

    </script>
}

@if (Context.Session.GetString("Email") == "admin@skateapp.ee")
{
    <script>

        map.on('click', function(e){

            const nimi =
                prompt("Sisesta skatepargi nimi:");

            if(!nimi)
                return;

            const tase =
                prompt("Sisesta tase: Algaja / Kesktase / Pro");

            if(!tase)
                return;

            fetch('/Home/AddPin', {

                method:'POST',

                headers:{
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body:
                `nimi=${encodeURIComponent(nimi)}
                &tase=${encodeURIComponent(tase)}
                &latitude=${e.latlng.lat}
                &longitude=${e.latlng.lng}`

            })
            .then(()=>{
                location.reload();
            });

        });

    </script>
}

<script>

    function deletePin(id)
    {
        if(!confirm("Kas soovid selle skatepargi kustutada?"))
            return;

        fetch('/Home/DeletePin?id=' + id, {
            method:'POST'
        })
        .then(()=>{
            location.reload();
        });
    }

    if (navigator.geolocation)
    {
        navigator.geolocation.getCurrentPosition(pos => {

            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;

            map.setView([lat, lng], 13);

            L.circleMarker([lat, lng], {

                radius: 10,
                color: '#e87722',
                fillColor: '#e87722',
                fillOpacity: 0.8

            })
            .addTo(map)
            .bindPopup("Sina oled siin")
            .openPopup();

        });
    }

</script>