@model List<SkateAppikene.Models.Review>

<h1>My Reviews</h1>

<div class="review-container">

    @if (Model.Count == 0)
    {
        <h3>No reviews found</h3>
    }

    @foreach (var review in Model)
    {
        <div class="review-card">

            <img src="@review.ParkImage" />

            <div class="review-info">

                <h3>@review.ParkName</h3>

                <p>
                    ⭐ @review.Score / 5
                </p>

            </div>

        </div>
    }

</div>

<style>

    .review-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 30px;
    }

    .review-card {
        width: 250px;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }

        .review-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

    .review-info {
        padding: 15px;
    }

</style>