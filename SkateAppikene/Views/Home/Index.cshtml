@{
    ViewData["Title"] = "Avaleht";
}

<style>
    .home-hero {
        text-align: center;
        padding: 4rem 1rem 3rem;
    }

    .home-logo {
        font-size: 3.5rem;
        font-weight: 900;
        color: #FFE600;
        text-shadow: 3px 3px 0 #000;
        letter-spacing: -2px;
        margin-bottom: 0.5rem;
    }

    .home-sub {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.5);
        margin-bottom: 2.5rem;
    }

    .home-actions {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 3.5rem;
    }

    .btn-yellow {
        background: #FFE600;
        color: #111;
        border: none;
        padding: 13px 28px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 15px;
        text-decoration: none;
        display: inline-block;
        transition: background 0.15s, transform 0.1s;
    }

        .btn-yellow:hover {
            background: #f0d800;
            color: #111;
            transform: translateY(-1px);
        }

    .btn-outline {
        border: 2px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.7);
        padding: 12px 28px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        display: inline-block;
        transition: border-color 0.15s, color 0.15s;
    }

        .btn-outline:hover {
            border-color: #FFE600;
            color: #FFE600;
        }

    .home-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        max-width: 820px;
        margin: 0 auto;
    }

    .home-tile {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 1.5rem;
        text-align: left;
    }

    .home-tile-icon {
        font-size: 1.8rem;
        margin-bottom: 0.6rem;
    }

    .home-tile-title {
        font-weight: 800;
        color: #FFE600;
        font-size: 1rem;
        margin-bottom: 0.3rem;
    }

    .home-tile-desc {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.45);
        line-height: 1.5;
    }
</style>

<div class="home-hero">
    <div class="home-logo">SkidParkz</div>
    <p class="home-sub">Leia Eesti parimad skatepargid, loe teiste arvamusi ja jaga enda kogemust.</p>

    <div class="home-actions">
        <a href="/Home/Map" class="btn-yellow">🗺 Vaata kaarti</a>
        @if (Context.Session.GetString("Kasutajanimi") != null)
        {
            <a asp-controller="Review" asp-action="MyReviews" class="btn-outline">Minu reviews</a>
        }
        else
        {
            <a href="/Account/Login" class="btn-outline">Logi sisse</a>
            <a href="/Account/Register" class="btn-outline">Registreeru</a>
        }
    </div>

    <div class="home-tiles">
        <div class="home-tile">
            <div class="home-tile-icon">📍</div>
            <div class="home-tile-title">Leia pargid</div>
            <div class="home-tile-desc">Kaardil on märgitud skatepargid üle Eesti koos taseme infoga.</div>
        </div>
        <div class="home-tile">
            <div class="home-tile-icon">⭐</div>
            <div class="home-tile-title">Lisa review</div>
            <div class="home-tile-desc">Olid pargis? Jaga oma arvamust teistele skeitaritele.</div>
        </div>
        <div class="home-tile">
            <div class="home-tile-icon">🛹</div>
            <div class="home-tile-title">Kõik tasemed</div>
            <div class="home-tile-desc">Algajast proni — leia endale sobiva tasemega park.</div>
        </div>
    </div>
</div>