@model List<SkateAppikene.Models.Review>

@{
    ViewData["Title"] = "Park Reviews";
}

<h2>@ViewBag.ParkName Reviews</h2>

<hr />



<h3>Lisa review</h3>

<form method="post" action="/Review/AddReview">

    <input type="hidden" name="ParkName" value="@ViewBag.ParkName" />

    <input type="text" name="Kasutajanimi" placeholder="Sinu nimi" required />
    <br /><br />

    <label>Hinne:</label>
    <select name="Score" required>
        <option value="5">5 ⭐</option>
        <option value="4">4 ⭐</option>
        <option value="3">3 ⭐</option>
        <option value="2">2 ⭐</option>
        <option value="1">1 ⭐</option>
    </select>

    <br /><br />

    <textarea name="Comment" placeholder="Kirjuta oma review..." required></textarea>

    <br /><br />

    <button type="submit">Lisa review</button>
</form>

<hr />


@if (!Model.Any())
{
    <p>Selle skatepargi kohta pole veel review'sid.</p>
}
else
{
    <div class="review-container">

        @foreach (var review in Model)
        {
            <div class="review-card">

                
                <img src="https://via.placeholder.com/300x200"
                     alt="@review.ParkName" />

                <div class="review-content">

                    <h4>@review.ParkName</h4>

                    <p>
                        ⭐ @review.Score / 5
                    </p>

                    <p>
                        @review.Comment
                    </p>

                    <p>
                        👤 @review.Kasutajanimi
                    </p>

                    <small>
                        @review.Id
                    </small>

                </div>

            </div>
        }

    </div>
}