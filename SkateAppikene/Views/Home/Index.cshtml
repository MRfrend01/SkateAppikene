@{
    ViewData["Title"] = "Avaleht";
}

<div class="home-hero">
    <div class="home-logo">SkateAppikene</div>
    <p class="home-sub">Leia Eesti parimad skatepargid, loe teiste arvamusi ja jaga enda kogemust.</p>

    <div class="home-actions">
        <a href="/Home/Map" class="btn-yellow">🗺 Vaata kaarti</a>
        @if (Context.Session.GetString("Kasutajanimi") != null)
        {
            <a asp-controller="Review" asp-action="MyReviews" class="btn-outline">Minu reviews</a>
        }
        else
        {
            <a href="/Account/Login" class="btn-outline">Logi sisse</a>
            <a href="/Account/Register" class="btn-outline">Registreeru</a>
        }
    </div>

    <div class="home-tiles">
        <div class="home-tile">
            <div class="home-tile-icon">📍</div>
            <div class="home-tile-title">Leia pargid</div>
            <div class="home-tile-desc">Kaardil on märgitud skatepargid üle Eesti koos taseme infoga.</div>
        </div>
        <div class="home-tile">
            <div class="home-tile-icon">⭐</div>
            <div class="home-tile-title">Lisa review</div>
            <div class="home-tile-desc">Olid pargis? Jaga oma arvamust teistele skeitaritele.</div>
        </div>
        <div class="home-tile">
            <div class="home-tile-icon">🛹</div>
            <div class="home-tile-title">Kõik tasemed</div>
            <div class="home-tile-desc">Algajast proni — leia endale sobiva tasemega park.</div>
        </div>
    </div>
</div>