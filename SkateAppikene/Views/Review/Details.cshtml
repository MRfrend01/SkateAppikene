@model SkateAppikene.Models.Review

<div class="container">

    <div class="left">

        <img src="@Model.ParkImage">

        <div class="score">
            ⭐ @Model.Score
        </div>

        <div class="buttons">

            <a class="delete"
               asp-action="Delete"
               asp-route-id="@Model.Id">
                Delete
            </a>

            <a class="modify"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                Modify
            </a>

        </div>

    </div>

    <div class="right">

        <h2>@Model.ParkName</h2>

        <div class="parkData">

            Park data

        </div>

        <div class="opinion">

            My opinion

        </div>

    </div>

</div>

<style>

    .container {
        display: flex;
        gap: 30px;
    }

    .left {
        width: 300px;
    }

        .left img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

    .score {
        margin-top: 15px;
        padding: 15px;
        border: 1px solid black;
    }

    .buttons {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .delete {
        background: red;
        padding: 10px;
        color: white;
    }

    .modify {
        background: dodgerblue;
        padding: 10px;
        color: white;
    }

    .right {
        flex: 1;
    }

    .parkData,
    .opinion {
        border: 1px solid black;
        padding: 40px;
        margin-top: 20px;
    }

</style>